# Supabase Configuration
# Replace with your Supabase Project URL and Anon Public API Key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Organizer Admin Passcode — choose your own secret, never publish it
VITE_ADMIN_PASSWORD=your-secure-passcode
